# OmniRoute — Nginx reverse proxy (subdomain) via omni.net
# Domain: omni.example.com → http://omniroute:20128 (container-to-container, no host port)
# Prereqs: .env → NEXT_PUBLIC_BASE_URL=https://omni.example.com, AUTH_COOKIE_SECURE=true, OMNIROUTE_BASE_PATH=
# Nginx container must be on same network: docker network connect omni.net <nginx-container>
# Host nginx (not containerized) should use 127.0.0.1:20128 and add ports: ["127.0.0.1:20128:20128"] to compose

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream omniroute {
  server omniroute:20128;
}

server {
  listen 80;
  server_name omni.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name omni.example.com;

  ssl_certificate /etc/letsencrypt/live/omni.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/omni.example.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 50m;
  proxy_read_timeout 300s;
  proxy_send_timeout 300s;

  location / {
    proxy_pass http://omniroute;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_buffering off;
    proxy_cache off;
  }
}
