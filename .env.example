# Required secrets
JWT_SECRET=change-me-openssl-rand-base64-48
API_KEY_SECRET=change-me-openssl-rand-hex-32
INITIAL_PASSWORD=CHANGEME
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# Image
OMNIROUTE_IMAGE_TAG=latest

# Network
PORT=20128
OMNIROUTE_BIND_HOST=127.0.0.1
NEXT_PUBLIC_BASE_URL=http://localhost:20128
BASE_URL=http://localhost:20128

# Redis
REDIS_URL=redis://redis:6379
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379

# Runtime memory (MB)
OMNIROUTE_MEMORY_MB=1024

# Security
OMNIROUTE_WS_BRIDGE_SECRET=change-me-openssl-rand-base64-32
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Node
NODE_ENV=production
CONTAINER_HOST=docker
