# OmniRoute — Environment template
# Copy to .env and fill secrets: cp .env.example .env
# Full reference: https://github.com/diegosouzapw/OmniRoute/blob/release/v3.8.51/docs/reference/ENVIRONMENT.md
# And Docker guide: https://github.com/diegosouzapw/OmniRoute/blob/release/v3.8.51/docs/guides/DOCKER_GUIDE.md

# ── Required secrets ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48  |  openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-base64-48
API_KEY_SECRET=change-me-openssl-rand-hex-32
INITIAL_PASSWORD=CHANGEME

# Optional at-rest DB encryption (leave empty to disable)
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# ── Image pinning ───────────────────────────────────────────────────
# Pin for GitOps; use 'latest' to follow stable, 'next' for pre-release, or a version tag.
OMNIROUTE_IMAGE_TAG=latest
# Examples:
# OMNIROUTE_IMAGE_TAG=3.8.51
# OMNIROUTE_IMAGE_TAG=next
# OMNIROUTE_IMAGE_TAG=main

# ── Network & ports ─────────────────────────────────────────────────
PORT=20128
# Bind host for published port: 127.0.0.1 = loopback only (secure), 0.0.0.0 = expose on LAN
OMNIROUTE_BIND_HOST=127.0.0.1

# Live WebSocket (dashboard real-time). Keep loopback unless fronted by proxy.
# LIVE_WS_PORT=20132
# LIVE_WS_HOST=127.0.0.1

# ── Reverse proxy / subpath ────────────────────────────────────────
# When serving behind Caddy/Traefik/nginx on a subpath or domain:
# OMNIROUTE_BASE_PATH=/omniroute
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
# Or: NEXT_PUBLIC_BASE_URL=https://your-domain.com/omniroute  (when using subpath)
NEXT_PUBLIC_BASE_URL=http://localhost:20128
BASE_URL=http://localhost:20128

# ── Redis sidecar ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_KEY_PREFIX=omniroute:

# ── Runtime memory (see DOCKER_GUIDE.md → Runtime RAM) ─────────────
# Dashboard / light chat: 1024 (default)
# One coding agent (Codex/Claude): 8192 + cgroup --memory=10g
# Two concurrent long /v1/responses: 10240-12288 + cgroup 12-16g
OMNIROUTE_MEMORY_MB=1024
# When raising above 1024, also raise container memory limit in docker-compose.yml (deploy.resources.limits.memory)

# ── Security ────────────────────────────────────────────────────────
# Required in production behind reverse proxy / public internet
OMNIROUTE_WS_BRIDGE_SECRET=change-me-openssl-rand-base64-32
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
# ALLOW_API_KEY_REVEAL=false
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ── Optional: provider local/private URLs (Ollama, LM Studio, etc.) ─
# OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=true
# OMNIROUTE_ALLOW_LOCAL_PROVIDER_URLS=true

# ── Node ────────────────────────────────────────────────────────────
NODE_ENV=production
CONTAINER_HOST=docker
